{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["vite/client", "node"]
  },
  "include": ["components", "demo", "lib", "tests", "index.ts", "vite.config.ts", "vite.lib.config.ts"],
  "exclude": ["node_modules", "dist", "tests/consumer"]
}
